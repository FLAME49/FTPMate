<Window x:Class="FTPMate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FTPMate"
        Width="420"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12.5"
        FlowDirection="LeftToRight"
        Icon="Assets/app.ico"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="22,18,22,14">

            <Grid Margin="0,0,0,14">
                <TextBlock Text="FTPMate"
                           FontSize="16.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <Border x:Name="StatusPill"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="9,5">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="6"
                                 Height="6"
                                 Fill="{StaticResource FaintBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText"
                                   Text="Stopped"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="6,0,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>

                    <StackPanel Margin="14,12,14,13">
                        <TextBlock Text="SHARE" Style="{StaticResource SectionLabel}" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="ModeFolderRadio"
                                         Grid.Column="0"
                                         Style="{StaticResource Segment}"
                                         Content="Folder"
                                         GroupName="ShareMode"
                                         Checked="ShareMode_Changed" />
                            <RadioButton x:Name="ModePartitionRadio"
                                         Grid.Column="2"
                                         Style="{StaticResource Segment}"
                                         Content="Drive"
                                         GroupName="ShareMode"
                                         Checked="ShareMode_Changed" />
                            <RadioButton x:Name="ModeAllRadio"
                                         Grid.Column="4"
                                         Style="{StaticResource Segment}"
                                         Content="All drives"
                                         GroupName="ShareMode"
                                         Checked="ShareMode_Changed" />
                        </Grid>

                        <Grid x:Name="FolderRow" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="FolderPathText"
                                       Grid.Column="0"
                                       Text="No folder selected"
                                       FontSize="12"
                                       Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />

                            <Button x:Name="ChooseFolderButton"
                                    Grid.Column="2"
                                    Content="Change"
                                    Style="{StaticResource GhostButton}"
                                    VerticalAlignment="Center"
                                    Click="ChooseFolder_Click" />
                        </Grid>

                        <WrapPanel x:Name="PartitionRow"
                                   Visibility="Collapsed"
                                   Margin="0,9,0,0" />

                        <StackPanel x:Name="AllRow"
                                    Visibility="Collapsed"
                                    Margin="0,9,0,0">
                            <TextBlock x:Name="AllDrivesText"
                                       FontSize="12"
                                       Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Each drive appears as a folder at the root."
                                       Style="{StaticResource HintText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource LineBrush}" />

                    <Grid Margin="14,9,14,9">
                        <TextBlock Text="PORT"
                                   Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center" />

                        <TextBox x:Name="PortBox"
                                 Style="{StaticResource FieldBox}"
                                 Width="78"
                                 Height="32"
                                 Text="2121"
                                 MaxLength="5"
                                 TextAlignment="Center"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 PreviewTextInput="PortBox_PreviewTextInput"
                                 PreviewKeyDown="PortBox_PreviewKeyDown" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource LineBrush}" />

                    <StackPanel Margin="14,10,14,12">
                        <TextBlock Text="ACCESS" Style="{StaticResource SectionLabel}" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="UsernameBox"
                                         Style="{StaticResource FieldBox}"
                                         Height="32"
                                         Text="ftp"
                                         Margin="0,5,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="PassBox"
                                             Style="{StaticResource FieldPassword}"
                                             Height="32"
                                             Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Optional. Empty password allows anonymous access."
                                   Style="{StaticResource HintText}"
                                   Margin="0,7,0,0" />
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource LineBrush}" />

                    <Grid Margin="14,10,14,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="START WITH WINDOWS" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Start the server at sign-in."
                                       Style="{StaticResource HintText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <CheckBox x:Name="AutoStartSwitch"
                                  Style="{StaticResource Switch}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Checked="AutoStartSwitch_Changed"
                                  Unchecked="AutoStartSwitch_Changed" />
                    </Grid>

                </StackPanel>
            </Border>

            <Button x:Name="StartButton"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,12,0,0"
                    Click="StartButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PowerGlyph"
                               Text="&#xE7E8;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Border x:Name="StopSquare"
                            Width="11"
                            Height="11"
                            CornerRadius="3"
                            Background="#141516"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Visibility="Collapsed" />
                    <TextBlock x:Name="PowerLabel"
                               Text="Start Server"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Border x:Name="InfoCard"
                    Visibility="Collapsed"
                    Style="{StaticResource Card}"
                    Padding="14,11"
                    Margin="0,10,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ADDRESS" Style="{StaticResource SectionLabel}" />
                            <TextBlock x:Name="AddressText"
                                       Text="ftp://"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource AccentBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,5,0,0" />
                        </StackPanel>

                        <Button x:Name="CopyButton"
                                Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                VerticalAlignment="Center"
                                ToolTip="Copy address"
                                Click="CopyButton_Click">
                            <TextBlock x:Name="CopyGlyph"
                                       Text="&#xE8C8;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" />
                        </Button>
                    </Grid>

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,9,0,8" />

                    <TextBlock x:Name="ClientsText"
                               Text="0 clients"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}" />

                    <TextBlock x:Name="ActivityText"
                               Text="No activity yet"
                               FontSize="11"
                               Foreground="{StaticResource FaintBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,3,0,0" />

                    <TextBlock Text="Allow FTPMate through Windows Firewall if clients can't connect."
                               Style="{StaticResource HintText}"
                               Margin="0,7,0,0" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="FooterText"
                       Text="Ready."
                       FontSize="11"
                       Foreground="{StaticResource FaintBrush}"
                       TextWrapping="Wrap"
                       Margin="2,10,2,0" />

        </StackPanel>
    </ScrollViewer>
</Window>
